{
  "name": "standard18-bacs",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "prepare": "husky install",
    "start": "pnpm build && node apps/api/dist/index.js",
    "test:ci": "vitest run",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@scarf/scarf"
    ]
  }
}
